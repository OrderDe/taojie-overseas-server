# Copy to .env on the server (or export in the service environment).

# Port to listen on (Nginx reverse-proxies /api/ to it).
PORT=3100

# Required for the admin endpoints and the admin UI at /admin
# (product/category management, RFQ list, site config).
# Pick a long random string. Leave empty to disable admin endpoints entirely.
ADMIN_TOKEN=

# Optional: every new RFQ is also POSTed as JSON to this URL
# (point it at a mail/WhatsApp notification gateway).
RFQ_WEBHOOK_URL=

# Optional: database file location (default: data/app.db in the project).
# DB_PATH=/var/lib/taojie-overseas/app.db
