# Java backend environment template. Export variables in the shell or service configuration.
# Spring Boot does not automatically load this file as .env.
# Docker Compose reads .env for the LibreTranslate service.

# Port to listen on (Nginx reverse-proxies /api/ to it).
SERVER_PORT=3100
SPRING_PROFILES_ACTIVE=dev
DB_USER=root
DB_PASSWORD=

# Break-glass root token for the admin API, AND the password of the
# initial admin account (username: admin) created on first boot while the
# user table is empty. Day-to-day logins use accounts managed in the
# admin UI (用户与角色). Pick a long random string.
# Leave empty to disable the root token and the initial-account bootstrap.
ADMIN_TOKEN=

# Optional: every new RFQ is also POSTed as JSON to this URL
# (point it at a mail/WhatsApp notification gateway).
RFQ_WEBHOOK_URL=

# Name auto-translate (admin forms, POST /api/admin/translate).
# DEFAULT is the self-hosted LibreTranslate started by docker-compose.yml
# in this repo (service "libretranslate", bound to 127.0.0.1:5000 only).
# LIBRETRANSLATE_URL defaults to http://127.0.0.1:5000; set
# LIBRETRANSLATE_API_KEY only if the instance requires API keys
# (LT_REQUIRE_API_KEY). Leaving the lines below commented out gives you
# the self-hosted default.
# TRANSLATE_PROVIDER=libre
# LIBRETRANSLATE_URL=http://127.0.0.1:5000
# LIBRETRANSLATE_API_KEY=
#
# Fallback (opt-in only, no silent switching): the free MyMemory API.
# TRANSLATE_PROVIDER=mymemory
# TRANSLATE_EMAIL= also raises the MyMemory daily quota.
TRANSLATE_EMAIL=
