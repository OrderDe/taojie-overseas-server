# Copy to .env on the server (or export in the service environment).

# Port to listen on (Nginx reverse-proxies /api/ to it).
PORT=3100

# Break-glass root token for the admin API, AND the password of the
# initial admin account (username: admin) created on first boot while the
# user table is empty. Day-to-day logins use accounts managed in the
# admin UI (用户与角色). Pick a long random string.
# Leave empty to disable the root token and the initial-account bootstrap.
ADMIN_TOKEN=

# Optional: every new RFQ is also POSTed as JSON to this URL
# (point it at a mail/WhatsApp notification gateway).
RFQ_WEBHOOK_URL=

# Optional: database file location (default: data/app.db in the project).
# DB_PATH=/var/lib/taojie-overseas/app.db
